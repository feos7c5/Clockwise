#!/bin/sh
# Erzwingt Conventional Commits: <typ>(<scope>)?: <beschreibung>
# Aktivieren: git config core.hooksPath .githooks
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,}'
if ! head -n1 "$1" | grep -Eq "$pattern"; then
  echo "✖ Commit-Nachricht entspricht nicht Conventional Commits." >&2
  echo "  Format: feat(scope): beschreibung   (feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert)" >&2
  exit 1
fi
