#!/bin/sh
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,}'
if ! head -n1 "$1" | grep -Eq "$pattern"; then
  echo "✖ Commit message does not follow Conventional Commits." >&2
  echo "  Format: type(scope): description   (feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert)" >&2
  exit 1
fi
