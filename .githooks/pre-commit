#!/bin/sh
# Every change to the app bumps the version and gives the service worker a new cache name and file list,
# so installed apps update themselves. CI checks the same with --check.
APP='index.html manifest.webmanifest assets'
bump=''
if git diff --cached --name-only -- $APP | grep -qv '^assets/js/version.js$'; then bump='--bump'; fi
exec node tools/build-meta.mjs --write $bump
